{% assign chapter = include.chapter %}
<section class="story-chapter story-{{ chapter.key }}" id="{{ chapter.id }}" data-story-chapter aria-labelledby="{{ chapter.id }}-title">
  <div class="story-stage">
    <div class="story-landscape" aria-hidden="true">
      {% assign landscape = chapter.key | prepend: '/assets/img/open-world/' | append: '.png' %}
      {% include cinematic-image.liquid path=landscape alt="" width=1672 height=941 sizes="100vw" %}
    </div>
    <div class="story-shade" aria-hidden="true"></div>
    <div class="story-aura" aria-hidden="true"></div>
    <div class="story-letterbox" aria-hidden="true"></div>
    <div class="story-topline section-shell">
      <span class="story-series">Open <b>×</b> World <span>A research journey</span></span>
      <nav class="story-chapters" aria-label="Story chapters">
        {% for scene in site.data.world_chapters %}
          <a
            href="#{{ scene.id }}"
            aria-label="Chapter {{ scene.number }}: {{ scene.name }}"
            {% if scene.id == chapter.id %}
              aria-current="step"
            {% endif %}
          >
            {{- scene.number -}}
          </a>
        {% endfor %}
      </nav>
    </div>
    <div class="story-content section-shell">
      <div class="story-copy">
        <p class="story-kicker">Chapter {{ chapter.number }} / {{ chapter.name }}</p>
        <h2 id="{{ chapter.id }}-title">
          {{ chapter.title_first -}}
          <br>
          <em>{{ chapter.title_second }}</em>
        </h2>
        <p class="story-introduction">{{ chapter.introduction }}</p>
        <div class="story-insight">
          <span class="story-insight-line" aria-hidden="true"></span>
          <h3>{{ chapter.insight }}</h3>
          <p>{{ chapter.connection }}</p>
        </div>
      </div>
      <figure class="story-character">
        <img
          src="{{ chapter.artwork | prepend: '/assets/img/hunter-echoes/' | relative_url }}"
          alt="{{ chapter.character }} from Hunter × Hunter"
          width="600"
          height="800"
          loading="lazy"
          decoding="async"
        >
        <figcaption>
          {{ chapter.character }}
          <span>Hunter × Hunter</span>
        </figcaption>
      </figure>
    </div>
    <div class="story-bottomline section-shell">
      <button class="story-nen" type="button" data-story-nen aria-pressed="false">
        <span aria-hidden="true">念</span> <span data-nen-label>Reveal Nen</span>
      </button>
      <span class="story-scroll-hint"><span class="story-scroll-line" aria-hidden="true"></span><span data-story-hint>Scroll to explore</span></span>
      <a class="story-continue" href="#{{ chapter.destination }}">
        {{- chapter.destination_label }}
        <span aria-hidden="true">↓</span></a
      >
    </div>
    <div class="story-progress" aria-hidden="true"></div>
  </div>
</section>
